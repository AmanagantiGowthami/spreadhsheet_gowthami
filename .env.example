# Copy to .env.local (git-ignored). Every value is optional.
#
# VITE_AI_PROVIDER   mock | http        (default: mock — deterministic, offline, no key needed)
# VITE_AI_ENDPOINT   URL of whichever LLM API you decide to call from src/ai/provider.js
# VITE_AI_API_KEY    key for that API (never commit a real key)
# VITE_AI_MODEL      model name passed through to your provider implementation
VITE_AI_PROVIDER=mock
VITE_AI_ENDPOINT=
VITE_AI_API_KEY=
VITE_AI_MODEL=
